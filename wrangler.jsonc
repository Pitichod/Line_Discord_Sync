{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "line-discord-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "BRIDGE", "class_name": "DiscordGateway" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DiscordGateway"] }
  ],
  "vars": {
    "DISCORD_CHANNEL_ID": "1562370482685345872"
  }
}

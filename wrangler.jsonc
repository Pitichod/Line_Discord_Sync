{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "line-discord-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "BRIDGE", "class_name": "DiscordGateway" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DiscordGateway"] }
  ],
  "vars": {
    "DISCORD_PUBLIC_KEY": "df9e25b4f129904a259b9c956a037963ccf782b083d25bf0ed57fd521ffeeb46"
  }
}
